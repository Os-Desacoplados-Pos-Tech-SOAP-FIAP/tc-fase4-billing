PORT=3004
NODE_ENV=development
DATABASE_URL=postgresql://billing:billing@localhost:5435/billing?schema=public
JWT_SECRET=troque-este-segredo-local

# Mensageria (LocalStack em dev; na AWS os valores vêm do Terraform/CD)
MESSAGING_ENABLED=true
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
INBOX_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/oficina-billing-inbox.fifo
EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:oficina-billing-events.fifo

# Orçamento
PUBLIC_BASE_URL=http://localhost:3004
ORCAMENTO_VALIDADE_HORAS=48
ORCAMENTO_EXPIRACAO_INTERVALO_MS=60000

# Pagamento: fake em dev; mercadopago só no EKS (credenciais no Secrets Manager)
PAYMENT_PROVIDER=fake
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Termina com ?source_news=webhooks: o Mercado Pago manda só webhooks assinados (sem IPN sem assinatura).
# ex.: https://<api-gateway>/api/billing/webhooks/mercadopago?source_news=webhooks
MP_NOTIFICATION_URL=
MP_API_URL=https://api.mercadopago.com

# Observabilidade (vazio = desligado)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=tc-fase4-billing
